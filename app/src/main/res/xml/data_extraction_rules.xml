<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing about this app leaves the device, including via backup. The TDLib
  session directory in particular is an authenticated Telegram session: copying
  it into a cloud backup would be the single worst thing this app could do.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
