<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      The window theme exists to get us to the first Compose frame without a
      flash of white, and to nothing else. All real styling lives in
      ui/theme/Theme.kt.
    -->
    <style name="Theme.HardPlay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink_black</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
    </style>

    <!--
      Splash. The animated icon is the *discreet* mark, not the branded one —
      a launcher icon that says "Archive" opening onto a splash that says
      something else would defeat the disguise before the biometric gate.
    -->
    <style name="Theme.HardPlay.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.HardPlay</item>
    </style>
</resources>
